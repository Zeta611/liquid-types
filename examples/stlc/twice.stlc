(
    val inc : x:int => int;
    let inc = (x) => {
        let one = 1;
        x + one
    };

    val twice : f:(a:int => int)
                => x:int => int;
    let twice = (f) => {
        (x) => {
            let y = f(x);
            f(y)
        }
    };

    let twice_inc = twice(inc);
    let n = 40;
    twice_inc(n)
) : int
